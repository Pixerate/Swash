---
// A screenshot in the page's theme: the light and dark captures from
// scripts/generate_site_screenshots.sh, one shown at a time (global.css).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  /** Above the fold: load at once. The hidden theme's image stays lazy, so it is never fetched. */
  eager?: boolean;
}
const { light, dark, alt, eager = false } = Astro.props;
const shared = {
  alt,
  widths: [640, 960, 1280, 1600],
  sizes: '(min-width: 1024px) 720px, 92vw',
  decoding: 'async' as const,
};
---

<Image src={light} {...shared} class="shot only-light" loading={eager ? 'eager' : 'lazy'} />
<Image src={dark} {...shared} class="shot only-dark" loading="lazy" />
