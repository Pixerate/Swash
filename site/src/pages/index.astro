---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroVideo from '../components/HeroVideo.svelte';
import PartnerDemo from '../components/PartnerDemo.svelte';
import FlairStage from '../components/FlairStage.svelte';
import SwashHeadline from '../components/SwashHeadline.svelte';
import Shot from '../components/Shot.astro';
import icon from '../assets/icon.png';
import editorLight from '../assets/screenshots/editor-light.png';
import editorDark from '../assets/screenshots/editor-dark.png';
import richLight from '../assets/screenshots/rich-light.png';
import richDark from '../assets/screenshots/rich-dark.png';
import focusLight from '../assets/screenshots/focus-light.png';
import focusDark from '../assets/screenshots/focus-dark.png';
import {
  DOWNLOAD,
  MIN_MACOS,
  REPO,
  agentTools,
  editorExtras,
  partnerFixes,
  partnerPrinciples,
  platforms,
} from '../data/features';

const title = 'Swash: just write. It dots the i’s and crosses the t’s.';
const description =
  'Swash is an agent-native Markdown editor for Mac with a writing partner that follows behind you, fixing spelling, capitals and punctuation while you stay in flow. Free and open source.';

const showcase = [
  {
    eyebrow: 'The editor',
    heading: 'Write Markdown the way it looks',
    body: 'Headings, lists, tables and to-dos appear formatted as you type, and the file underneath stays plain Markdown that opens anywhere. Switch to Source or Split whenever you want to see the marks.',
    light: editorLight,
    dark: editorDark,
    alt: 'Swash editing a document called Field Notes, with an outline of its headings in the sidebar.',
  },
  {
    eyebrow: 'Rich content',
    heading: 'Diagrams, math and tables, all offline',
    body: 'Mermaid diagrams and KaTeX math render in place with no connection. Tables are editable cell by cell, code is highlighted, and GitHub alerts and footnotes just work.',
    light: richLight,
    dark: richDark,
    alt: 'A Swash document with a rendered flow diagram, a table of costs and a formula.',
  },
  {
    eyebrow: 'Focus',
    heading: 'Nothing on screen but the sentence',
    body: 'Focus Mode dims everything except the paragraph or sentence you are in. Add Typewriter Scrolling to keep your line in the middle, or go distraction-free and lose the window chrome too.',
    light: focusLight,
    dark: focusDark,
    alt: 'Swash in Focus Mode, with every paragraph dimmed except the one being written.',
  },
];
---

<Base {title} {description}>
  <header class="absolute inset-x-0 top-0 z-20">
    <nav class="mx-auto flex max-w-6xl items-center gap-6 px-5 py-4 sm:px-8" aria-label="Main">
      <a href="/" class="flex items-center gap-2.5 font-serif text-xl font-bold italic text-ink no-underline">
        <Image src={icon} alt="" width={32} height={32} loading="eager" />
        Swash
      </a>
      <div class="ml-auto hidden items-center gap-6 text-sm font-medium text-muted sm:flex">
        <a class="hover:text-ink" href="#partner">Writing partner</a>
        <a class="hover:text-ink" href="#editor">Editor</a>
        <a class="hover:text-ink" href="#agents">Agents</a>
        <a class="hover:text-ink" href={REPO}>GitHub</a>
      </div>
      <a href={DOWNLOAD} class="btn btn-primary ml-auto !px-4 !py-2 text-sm sm:ml-0">Download</a>
    </nav>
  </header>

  <main class="overflow-x-clip">
    <!-- Hero -->
    <section class="relative overflow-hidden px-5 pb-16 pt-32 sm:px-8 sm:pt-40">
      <HeroVideo client:load />
      <div class="relative z-10 mx-auto max-w-4xl text-center">
        <p class="eyebrow">Markdown editor for Mac <span class="text-muted">· iPhone and iPad coming soon</span></p>
        <h1 class="mt-8 font-serif text-[clamp(3.25rem,10vw,7rem)] font-bold leading-[0.95] tracking-tight">
          <SwashHeadline client:load text="Just write." />
        </h1>
        <p class="mx-auto mt-5 max-w-2xl font-serif text-[clamp(1.4rem,3.4vw,2.1rem)] italic leading-snug text-ink">
          Swash dots the i’s and crosses the t’s.
        </p>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted">
          An agent-native Markdown editor with a writing partner that follows a few words behind you, quietly fixing
          spelling, capitals and punctuation. You stay in the sentence you’re writing. It takes care of the ones you’ve
          finished.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href={DOWNLOAD} class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13m0 0l-5-5m5 5l5-5M4 21h16"></path></svg>
            Download for Mac
          </a>
          <a href={REPO} class="btn btn-ghost">View on GitHub</a>
        </div>
        <p class="mt-4 text-sm text-muted">Free and open source · macOS {MIN_MACOS} or later</p>
      </div>

      <div class="relative z-10 mt-14 px-0 sm:px-4">
        <PartnerDemo client:visible />
      </div>
    </section>

    <!-- Writing partner -->
    <section id="partner" class="mx-auto max-w-6xl scroll-mt-10 px-5 py-20 sm:px-8 sm:py-28">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">The writing partner</p>
        <h2 class="mt-3 font-serif text-4xl font-bold tracking-tight sm:text-5xl">The busywork, taken care of</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Most of the effort in a document isn’t the writing. It’s going back for the capital you skipped and the
          apostrophe you meant to add. Type as you normally would, and Swash’s cursor follows behind to put them right.
        </p>
      </div>

      <ul data-reveal class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-line shadow-[0_0_0_1px_var(--line)] sm:grid-cols-2 lg:grid-cols-4">
        {
          partnerFixes.map((fix) => (
            <li class="flex flex-col bg-surface p-6">
              <h3 class="flex items-center gap-2 text-base font-semibold">
                {fix.title}
                {fix.status === 'soon' && (
                  <a class="soon no-underline" href={fix.issue ? `${REPO}/issues/${fix.issue}` : undefined}>
                    Coming soon
                  </a>
                )}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{fix.body}</p>
              {fix.example && (
                <p class="mt-auto pt-5 font-mono text-[0.8125rem]">
                  <span class="text-muted line-through decoration-1">{fix.example[0]}</span>
                  <span class="px-1.5 text-muted" aria-label="becomes">→</span>
                  <span class="font-semibold text-partner">{fix.example[1]}</span>
                </p>
              )}
            </li>
          ))
        }
        <li class="flex flex-col justify-center bg-surface p-6">
          <p class="text-sm leading-relaxed text-muted">
            The partner is on from the start with the rules that run on your Mac. Pause it for a document with{' '}
            <strong class="font-semibold text-ink">⌥⌘P</strong>, or choose Suggest, Off and individual rules in{' '}
            <strong class="font-semibold text-ink">Settings › Writing</strong>.
          </p>
        </li>
      </ul>

      <dl class="mt-14 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
        {
          partnerPrinciples.map((item, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <dt class="font-serif text-xl font-bold">{item.title}</dt>
              <dd class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Editor -->
    <section id="editor" class="scroll-mt-10 border-y border-line bg-surface/60">
      <div class="mx-auto max-w-6xl space-y-24 px-5 py-20 sm:px-8 sm:py-28">
        {
          showcase.map((item, i) => (
            <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
              <div class={i % 2 ? 'lg:order-2' : ''} data-reveal={i % 2 ? 'right' : 'left'}>
                <p class="eyebrow">{item.eyebrow}</p>
                <h2 class="mt-3 font-serif text-3xl font-bold tracking-tight sm:text-4xl">{item.heading}</h2>
                <p class="mt-4 text-lg leading-relaxed text-muted">{item.body}</p>
              </div>
              <div class={i % 2 ? 'lg:order-1' : ''} data-reveal={i % 2 ? 'left' : 'right'} style="--reveal-delay: 120ms">
                <Shot light={item.light} dark={item.dark} alt={item.alt} />
              </div>
            </div>
          ))
        }

        <div data-reveal>
          <h2 class="font-serif text-2xl font-bold tracking-tight">And the rest of a proper Mac app</h2>
          <ul class="mt-6 grid gap-x-10 gap-y-3 text-[0.9375rem] text-muted sm:grid-cols-2 lg:grid-cols-3">
            {
              editorExtras.map((extra) => (
                <li class="flex gap-2.5">
                  <span class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent" aria-hidden="true" />
                  {extra}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Agents -->
    <section id="agents" class="mx-auto max-w-6xl scroll-mt-10 px-5 py-20 sm:px-8 sm:py-28">
      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
        <div data-reveal="left">
          <p class="eyebrow">Agent-native</p>
          <h2 class="mt-3 font-serif text-4xl font-bold tracking-tight sm:text-5xl">Built for agents as well as people</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted">
            Swash gives an AI agent the same document you’re looking at, through a small set of precise tools over the
            Model Context Protocol. It can read, find, insert, replace and format, and it works in Markdown, not
            screenshots.
          </p>
          <ul class="mt-6 space-y-3 text-[0.9375rem] leading-relaxed text-muted">
            <li><strong class="font-semibold text-ink">Every agent edit is one undo step,</strong> exactly like the writing partner’s.</li>
            <li><strong class="font-semibold text-ink">Read-only documents stay read-only:</strong> an agent can look, and nothing more.</li>
            <li><strong class="font-semibold text-ink">Off until you turn it on,</strong> in Settings › Agents on the Mac.</li>
          </ul>
        </div>
        <div data-reveal="right" style="--reveal-delay: 120ms" class="rounded-3xl bg-surface p-6 shadow-[0_0_0_1px_var(--line)] sm:p-8">
          <p class="text-sm font-semibold text-muted">Tools an agent can call</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              agentTools.map((tool) => (
                <li class="rounded-lg bg-page px-3 py-1.5 font-mono text-[0.8125rem] shadow-[0_0_0_1px_var(--line)]">{tool}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Platforms and download -->
    <section id="download" class="mx-auto max-w-6xl scroll-mt-10 px-5 pb-24 sm:px-8">
      <div data-reveal>
      <FlairStage client:visible>
        <p class="mt-2 max-w-xl font-serif text-2xl italic leading-snug sm:text-3xl">
          Stay in the sentence you’re writing.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href={DOWNLOAD} class="btn btn-primary">Download for Mac</a>
          <a href={`${REPO}/releases/latest`} class="btn btn-ghost">Release notes</a>
        </div>
        <ul class="mt-10 grid w-full max-w-2xl gap-3 text-left sm:grid-cols-2">
          {
            platforms.map((platform) => (
              <li class="rounded-2xl bg-surface/80 p-5 shadow-[0_0_0_1px_var(--line)] backdrop-blur">
                <h3 class="flex items-center gap-2 font-semibold">
                  {platform.name}
                  {platform.status === 'soon' ? (
                    <a class="soon no-underline" href={`${REPO}/issues/${platform.issue}`}>Coming soon</a>
                  ) : (
                    <span class="soon">Available now</span>
                  )}
                </h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{platform.detail}</p>
              </li>
            ))
          }
        </ul>
      </FlairStage>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 text-sm text-muted sm:flex-row sm:items-center sm:px-8">
      <p>
        Swash is made by <a class="text-ink underline decoration-line underline-offset-4" href="https://pixerate.com">Pixerate</a>{' '}
        and released under the MIT licence.
      </p>
      <p class="sm:ml-auto">
        Hero video AI-generated with <a class="text-ink underline decoration-line underline-offset-4" href="https://github.com/slopmachine-dev/slopmachine-sdk">Slop Machine</a>.
        Effects by <a class="text-ink underline decoration-line underline-offset-4" href="https://flair.pixerate.com">Flair</a>.
      </p>
    </div>
  </footer>
</Base>
